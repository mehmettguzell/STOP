# ──────────────────────────────────────────
# Spring Profile (prod | dev)
# ──────────────────────────────────────────
SPRING_PROFILES_ACTIVE=prod

# ──────────────────────────────────────────
# Deployment image source (prod only — set by the deploy pipeline,
# not needed for local dev which builds via docker-compose.override.yml)
# ──────────────────────────────────────────
GHCR_REGISTRY=ghcr.io/mehmettguzell
IMAGE_TAG=latest

# ──────────────────────────────────────────
# CORS
# ──────────────────────────────────────────
ALLOWED_ORIGIN=

# ──────────────────────────────────────────
# Communication DB
# ──────────────────────────────────────────
COMMUNICATION_DB_NAME=
COMMUNICATION_DB_USER=
COMMUNICATION_DB_PASSWORD=
COMMUNICATION_DB_URL=

# ──────────────────────────────────────────
# Identity DB
# ──────────────────────────────────────────
IDENTITY_DB_NAME=
IDENTITY_DB_USER=
IDENTITY_DB_PASSWORD=
IDENTITY_DB_URL=

# ──────────────────────────────────────────
# Match DB
# ──────────────────────────────────────────
MATCH_DB_NAME=
MATCH_DB_USER=
MATCH_DB_PASSWORD=
MATCH_DB_URL=

# ──────────────────────────────────────────
# Notification DB
# ──────────────────────────────────────────
NOTIFICATION_DB_NAME=
NOTIFICATION_DB_USER=
NOTIFICATION_DB_PASSWORD=
NOTIFICATION_DB_URL=

# ──────────────────────────────────────────
# Redis
# ──────────────────────────────────────────
REDIS_URL=

# ──────────────────────────────────────────
# Kafka
# ──────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=

# ──────────────────────────────────────────
# JWT Keys
# ──────────────────────────────────────────
JWT_PUBLIC_KEY=
JWT_PRIVATE_KEY=

# ──────────────────────────────────────────
# API Gateway – upstream URIs
# ──────────────────────────────────────────
GATEWAY_IDENTITY_URI=
GATEWAY_MODERATION_URI=
GATEWAY_MATCH_URI=
GATEWAY_NOTIFICATION_URI=
GATEWAY_COMMUNICATION_URI=
GATEWAY_COMMUNICATION_WS_URI=

# ──────────────────────────────────────────
# Service-to-service URLs
# ──────────────────────────────────────────
MATCH_SERVICE_URL=

# ──────────────────────────────────────────
# Profile photo storage (identity-service)
# Photos are saved to a local volume (identity_avatars, mounted at
# /data/avatars in the container) and served back by identity-service
# itself. PUBLIC_BASE_URL must be the address clients use to reach the
# API (api-gateway) — it's baked into every avatarUrl returned to the
# app, so it must be resolvable from the client's network, not just
# from inside the Docker network.
# ──────────────────────────────────────────
PUBLIC_BASE_URL=http://localhost:8080/api/v1
